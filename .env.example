# =====================
# OpenAI
# =====================
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# =====================
# Database
# =====================
DATABASE_URL=

# =====================
# JWT
# =====================
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# =====================
# LangSmith
# =====================
LANGCHAIN_API_KEY=
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=AstraStudy

# =====================
# Langfuse
# =====================
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=

# =====================
# Qdrant
# =====================
QDRANT_URL=
QDRANT_API_KEY=

# =====================
# Docling / OCR
# =====================
DOCLING_OCR_ENABLED=true
DOCLING_OCR_LANGUAGES=["en"]
DOCLING_FORCE_FULL_PAGE_OCR=false
DOCLING_DISABLE_HF_SYMLINKS=true
